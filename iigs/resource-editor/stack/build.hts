on buildSounds
  makeCard "Sounds"
  putScript "card", "sounds"
  topOfCard "Sounds"
  mkFld "List", "226,34,316,80", "scrolling", empty
  set script of card field "List" to handler("pickSound the value of the clickLine")
  mkFld "Info", "226,84,316,108", "transparent", empty
  mkBtn "Save", "226,112,269,125", "roundRect", "saveSound"
  mkBtn "Play", "272,112,316,125", "roundRect", "playSound"
  mkBtn "Import...", "226,128,269,141", "roundRect", "askImport"
  mkBtn "Name...", "272,128,316,141", "roundRect", "renameSound"
  mkBtn "Delete", "226,144,269,157", "roundRect", "deleteSound"
  mkFld "L1", "4,160,30,172", "transparent", "Rate"
  mkEdit "Rate", "32,160,70,172"
  mkFld "L2", "74,160,100,172", "transparent", "Pitch"

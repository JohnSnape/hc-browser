  mkBtn "1 R/B", "42,176,70,190", "roundRect", "setPen 1"
  mkBtn "2 G/Y", "72,176,100,190", "roundRect", "setPen 2"
  mkBtn "3 White", "102,176,138,190", "roundRect", "setPen 3"
  mkBtn "Clear", "140,176,168,190", "roundRect", "setPen " & quote & "." & quote
  mkBtn "Invert", "170,176,202,190", "roundRect", "setPen x"
  mkBtn "Hot", "204,176,224,190", "roundRect", "setPen h"
  mkBtn "New...", "226,147,269,160", "roundRect", "askNew"
  mkBtn "Save", "272,147,316,160", "roundRect", "saveCursor"
  mkBtn "Save As...", "226,162,269,175", "roundRect", "saveAs"
  mkBtn "Name...", "272,162,316,175", "roundRect", "renameCursor"
  mkBtn "Delete", "226,177,269,190", "roundRect", "deleteCursor"

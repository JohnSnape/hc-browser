on buildFonts
  makeCard "Fonts"
  putScript "card", "fonts"
  topOfCard "Fonts"
  mkFld "List", "226,34,316,110", "scrolling", empty
  set script of card field "List" to handler("pickFont the value of the clickLine")
  mkBtn "Folder...", "226,112,269,125", "roundRect", "askFolder"
  mkFld "FontInfo", "146,34,222,70", "transparent", empty
  mkFld "Info", "146,74,222,96", "transparent", empty
  mkEdit "Code", "146,100,180,112"
  set script of card field "Code" to "on closeField" & return & "pickChar me" & return & "end closeField"
  mkBtn "<", "182,99,196,113", "roundRect", "nextChar -1"
  mkBtn ">", "198,99,212,113", "roundRect", "nextChar 1"
  mkBtn "Char...", "146,116,190,130", "roundRect", "askChar"
  mkBtn "Ink", "4,176,40,190", "roundRect", "setPen 1"
  mkBtn "Paper", "42,176,80,190", "roundRect", "setPen 0"
  mkBtn "Width -", "84,176,120,190", "roundRect", "widthBy -1"
  mkBtn "Width +", "122,176,158,190", "roundRect", "widthBy 1"
  mkBtn "Save", "176,176,212,190", "roundRect", "saveGlyph"
  mkBtn "Revert", "226,176,269,190", "roundRect", "revertGlyph"
end buildFonts

on buildPatterns
  makeCard "Patterns"
  putScript "card", "patterns"
  topOfCard "Patterns"
  mkFld "Info", "4,140,220,152", "transparent", empty
  mkBtn "Save", "4,156,44,170", "roundRect", "savePattern"
  mkBtn "Revert", "48,156,96,170", "roundRect", "revertPattern"
  mkBtn "0 Black", "4,176,40,190", "roundRect", "setPen 0"
  mkBtn "1 Red/Blue", "42,176,92,190", "roundRect", "setPen 1"
  mkBtn "2 Grn/Yel", "94,176,140,190", "roundRect", "setPen 2"
  mkBtn "3 White", "142,176,178,190", "roundRect", "setPen 3"
  repeat with n = 0 to 15
    put 227 + 28 * (n div 8) into x
    put 34 + 18 * (n mod 8) into y
    mkBtn "P" & n, x & "," & y & "," & x + 18 & "," & y + 20, "transparent", "pickPattern " & n
    set showName of card button ("P" & n) to false
  end repeat
end buildPatterns

-- every editing card: its title and a button back to the Home card
on topOfCard t
  mkFld "Title", "4,16,220,30", "transparent", t
  set textStyle of card field "Title" to bold
  mkBtn "Home", "286,16,316,30", "roundRect", goCard("Home")
end topOfCard

-- set the script of this stack or this card from a source file
on putScript what, src
  global gSrc
  get rsrc("readtext", gSrc & src)
  if char 1 to 4 of it is "ERR " then answer src & ": " & it
  if what is "stack" then set script of this stack to it
  else set script of this card to it
end putScript

function handler cmd
  return "on mouseUp" & return & cmd & return & "end mouseUp"
end handler

function goCard nm
  return "go card " & quote & nm & quote
end goCard

on makeCard nm
  send "doMenu" && quote & "New Card" & quote to HyperCard
  set name of this card to nm
end makeCard

on mkBtn nm, r, st, cmd
  send "doMenu" && quote & "New Button" & quote to HyperCard
  put the number of card buttons into n
  set name of card button n to nm
  set rect of card button n to r
  set style of card button n to st
  set showName of card button n to true
  set script of card button n to handler(cmd)
end mkBtn

on mkFld nm, r, st, txt
  send "doMenu" && quote & "New Field" & quote to HyperCard
  put the number of card fields into n
  set name of card field n to nm
  set rect of card field n to r
  set style of card field n to st
  set lockText of card field n to true
  put txt into card field n
end mkFld

-- a field the user types into
on mkEdit nm, r
  mkFld nm, r, "rectangle", empty
  set lockText of card field nm to false
end mkEdit

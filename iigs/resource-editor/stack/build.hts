-- build.hts: makes the Rsrc.Editor stack on the IIGS, by script.
-- Run from Home (see test/rig.sh: Home's startUp loads this file into
-- the card script and sends "boot"). The card scripts come from text
-- files in :HyperCard:RE.Src: next to it. The XFCN "rsrc" must be
-- reachable (Home's resource fork during the build); afterwards it is
-- added to the new stack's own fork on the host (tools/make-disk.sh).
-- Menu commands go straight to HyperCard so Home's own handlers (which
-- warn about new cards and backgrounds) never see them. All cards share
-- one empty background; every object is a card object.
-- Rects are in HyperCard units: x counts 2 screen pixels, y 1.

on boot
  global gSrc
  put ":HyperCard:RE.Src:" into gSrc
  set userLevel to 5
  set lockMessages to true
  do "create stack " & quote & ":HyperCard:Rsrc.Editor" & quote
  putScript "stack", "stack"
  buildHome
  buildIcons
  buildCursors
  buildSounds
  buildVersion
  buildFonts
  buildPatterns
  choose browse tool
  set lockMessages to false
  go to card "Home"
  -- leave the stack (the Home STACK: "go home") so HyperCard writes
  -- all of it out, then signal
  go home
  wait 5 seconds
  get rsrc("writetext", ":HyperCard:Done", "ok")
end boot

on buildHome
  set name of this card to "Home"
  putScript "card", "home"
  mkFld "Title", "4,14,316,32", "transparent", "IIGS Resource Editor"
  set textSize of card field "Title" to 12
  set textStyle of card field "Title" to bold
  mkFld "Folder", "4,34,200,46", "transparent", empty
  mkBtn "Up", "204,33,240,47", "roundRect", "goUp"
  mkFld "Files", "4,48,200,150", "scrolling", empty
  set script of card field "Files" to handler("pickFile the value of the clickLine")
  mkBtn "This Stack", "204,52,316,66", "roundRect", "useFile empty"
  mkBtn "Pathname...", "204,70,316,84", "roundRect", "askPath"
  mkFld "File", "4,154,316,166", "transparent", empty
  mkFld "Summary", "4,168,316,180", "transparent", empty
  mkBtn "Icons", "4,184,54,198", "roundRect", goCard("Icons")
  mkBtn "Cursors", "56,184,106,198", "roundRect", goCard("Cursors")
  mkBtn "Sounds", "108,184,158,198", "roundRect", goCard("Sounds")
  mkBtn "Version", "160,184,210,198", "roundRect", goCard("Version")
  mkBtn "Fonts", "212,184,262,198", "roundRect", goCard("Fonts")
  mkBtn "Patterns", "264,184,316,198", "roundRect", goCard("Patterns")
end buildHome

on buildIcons
  makeCard "Icons"
  putScript "card", "icons"
  topOfCard "Icons"
  mkFld "Info", "226,84,316,108", "transparent", empty
  mkFld "List", "226,110,316,145", "scrolling", empty
  set script of card field "List" to handler("pickIcon the value of the clickLine")
  mkBtn "0 Black", "4,176,40,190", "roundRect", "setPen 0"
  mkBtn "1 Red/Blue", "42,176,92,190", "roundRect", "setPen 1"
  mkBtn "2 Grn/Yel", "94,176,140,190", "roundRect", "setPen 2"
  mkBtn "3 White", "142,176,178,190", "roundRect", "setPen 3"
  mkBtn "Clear", "180,176,210,190", "roundRect", "setPen " & quote & "." & quote
  mkBtn "New...", "226,147,269,160", "roundRect", "askNew"
  mkBtn "Save", "272,147,316,160", "roundRect", "saveIcon"
  mkBtn "Save As...", "226,162,269,175", "roundRect", "saveAs"
  mkBtn "Name...", "272,162,316,175", "roundRect", "renameIcon"
  mkBtn "Delete", "226,177,269,190", "roundRect", "deleteIcon"
  mkBtn "Color", "272,177,316,190", "checkBox", "toggleColor"
end buildIcons


  makeCard "Version"
  putScript "card", "version"
  topOfCard "Version"
  mkFld "Which", "4,34,200,46", "transparent", empty
  mkFld "List", "226,40,316,100", "scrolling", empty
  set script of card field "List" to handler("pickVersion the value of the clickLine")
  mkFld "L1", "4,50,44,62", "transparent", "Major"
  mkEdit "Major", "46,50,76,62"
  mkFld "L2", "82,50,118,62", "transparent", "Minor"
  mkEdit "Minor", "120,50,150,62"
  mkFld "L3", "156,50,180,62", "transparent", "Bug"
  mkEdit "Bug", "182,50,212,62"
  mkFld "L4", "4,66,44,78", "transparent", "Stage"
  mkEdit "Stage", "46,66,130,78"
  mkFld "L5", "136,66,176,78", "transparent", "Release"
  mkEdit "Release", "178,66,212,78"
  mkFld "L6", "4,82,44,94", "transparent", "Region"
  mkEdit "Region", "46,82,90,94"
  mkFld "L7", "4,98,44,110", "transparent", "Name"
  mkEdit "Name", "46,98,316,110"
  mkFld "L8", "4,114,44,126", "transparent", "Info"
